// GS RERP — WMS + Logistika ma'lumotlar bazasi sxemasi

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  warehouse
  logistics
  accounting
  sales
}

enum LocationType {
  warehouse
  border_crossing
  customs
}

enum PackingType {
  carton
  woven_bag
  pallet
  other
}

enum BatchStatus {
  in_stock
  partially_loaded
  fully_loaded
}

enum TruckStatus {
  loading
  departed
  arrived
}

enum LoadingEventStatus {
  loading
  departed
  arrived
  cleared
}

enum CostType {
  forklift
  customs
  tax_refund
  other
}

enum ReconciliationStatus {
  pending
  confirmed
  discrepancy
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Ombor xodimi (warehouse) uchun biriktirilgan yagona ombor — shu xodim faqat
  // shu joylashuvdagi kirim/qoldiqni ko'radi. Boshqa rollar uchun bo'sh qoladi.
  location   Location? @relation(fields: [locationId], references: [id])
  locationId String?

  intakeBatches   IntakeBatch[]     @relation("IntakeCreatedBy")
  intakeReceipts  IntakeReceipt[]   @relation("IntakeReceiptCreatedBy")
  loadingEvents   LoadingEvent[]    @relation("LoadingEventCreatedBy")
  loadingLines    LoadingLineItem[] @relation("LoadingLineCreatedBy")
  loadingCosts    LoadingCost[]     @relation("LoadingCostCreatedBy")
  auditLogs       AuditLog[]
  assignedClients Client[]          @relation("ClientSalesManager")

  @@index([locationId])
  @@map("users")
}

// Single row (id=1) holding the next auto-suggested client code (e.g. "GS425"). Sales
// managers can still type any custom code (special/round codes like GS777, GS5909) —
// the counter only advances when the suggested value is actually used, so overriding it
// never skips or collides with the sequence.
model GsCodeCounter {
  id        Int    @id @default(1)
  prefix    String @default("GS")
  nextValue Int    @default(1)

  @@map("gs_code_counter")
}

// Single row (id=1) holding the next letter index (0->A, 1->B, ... 25->Z, 26->AA...)
// for IntakeBatch.letterCode. Continues across every intake ever created — not reset
// per receipt or per client — so each product line gets a permanently unique letter.
model IntakeLetterCounter {
  id        Int @id @default(1)
  nextIndex Int @default(0)

  @@map("intake_letter_counter")
}

model Client {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  phone          String?
  notes          String?
  isActive       Boolean  @default(true)
  portalUserId   String?  @unique // future client-portal seam, unused in MVP
  salesManager   User?    @relation("ClientSalesManager", fields: [salesManagerId], references: [id])
  salesManagerId String?
  createdAt      DateTime @default(now())

  intakeBatches           IntakeBatch[]
  intakeReceipts          IntakeReceipt[]
  deliveryReconciliations DeliveryReconciliation[]

  @@index([salesManagerId])
  @@map("clients")
}

model Location {
  id      String       @id @default(cuid())
  name    String
  type    LocationType
  country String

  intakeBatches        IntakeBatch[]
  intakeBatchesCurrent IntakeBatch[]       @relation("IntakeCurrentLocation")
  intakeReceipts       IntakeReceipt[]
  trucksHere           Truck[]             @relation("TruckCurrentLocation")
  loadingEventsFrom    LoadingEvent[]      @relation("LoadingEventFrom")
  loadingEventsTo      LoadingEvent[]      @relation("LoadingEventTo")
  transitCheckpoints   TransitCheckpoint[]
  assignedUsers        User[]

  @@map("locations")
}

// One warehouse delivery event (bitta GS-kod + bitta sana + bir nechta mahsulot qatori),
// yaratilgan bulk Kirim submitiga mos keladi. Umumiy qabul rasmlari shu yerga bog'lanadi;
// har bir mahsulot qatorining o'z rasmi esa IntakeBatch.photos orqali saqlanadi.
model IntakeReceipt {
  id          String   @id @default(cuid())
  client      Client   @relation(fields: [clientId], references: [id])
  clientId    String
  location    Location @relation(fields: [locationId], references: [id])
  locationId  String
  intakeDate  DateTime
  createdBy   User     @relation("IntakeReceiptCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())

  batches IntakeBatch[]
  photos  IntakePhoto[] @relation("IntakeReceiptPhotos")

  @@index([clientId])
  @@map("intake_receipts")
}

model IntakePhoto {
  id              String         @id @default(cuid())
  data            Bytes
  mimeType        String
  intakeReceipt   IntakeReceipt? @relation("IntakeReceiptPhotos", fields: [intakeReceiptId], references: [id])
  intakeReceiptId String?
  intakeBatch     IntakeBatch?   @relation("IntakeBatchPhotos", fields: [intakeBatchId], references: [id])
  intakeBatchId   String?
  createdAt       DateTime       @default(now())

  @@index([intakeReceiptId])
  @@index([intakeBatchId])
  @@map("intake_photos")
}

model IntakeBatch {
  id                String         @id @default(cuid())
  client            Client         @relation(fields: [clientId], references: [id])
  clientId          String
  location          Location       @relation(fields: [locationId], references: [id])
  locationId        String
  receipt           IntakeReceipt? @relation(fields: [receiptId], references: [id])
  receiptId         String?
  intakeDate        DateTime
  productName       String?
  // Har bir tovar qatoriga (partiyaga) berilgan doimiy harf — A, B, C... Ketma-ketlik
  // butun tizim bo'yicha uzluksiz davom etadi: 1-kirimda 2 tovar bo'lsa A, B; keyingi
  // kirimning tovarlari C, D bo'lib davom etadi. Jismoniy karobkalar soniga bog'liq emas.
  letterCode        String?
  packingType       PackingType
  lengthM           Decimal?       @db.Decimal(8, 3)
  widthM            Decimal?       @db.Decimal(8, 3)
  heightM           Decimal?       @db.Decimal(8, 3)
  packageCount      Int
  unitQty           Int?
  volumeCbm         Decimal        @db.Decimal(10, 3)
  unitGrossWeightKg Decimal?       @db.Decimal(10, 2)
  totalWeightKg     Decimal        @db.Decimal(10, 2)
  costNotes         String?
  status            BatchStatus    @default(in_stock)
  currentLocation   Location       @relation("IntakeCurrentLocation", fields: [currentLocationId], references: [id])
  currentLocationId String
  inTransit         Boolean        @default(false)
  createdBy         User           @relation("IntakeCreatedBy", fields: [createdById], references: [id])
  createdById       String
  createdAt         DateTime       @default(now())

  loadingLines LoadingLineItem[]
  photos       IntakePhoto[]     @relation("IntakeBatchPhotos")

  @@index([clientId])
  @@index([locationId])
  @@index([receiptId])
  @@index([status])
  @@index([currentLocationId])
  @@map("intake_batches")
}

model Truck {
  id                String      @id @default(cuid())
  code              String      @unique
  plateNumber       String?
  currentLocation   Location?   @relation("TruckCurrentLocation", fields: [currentLocationId], references: [id])
  currentLocationId String?
  status            TruckStatus @default(loading)
  createdAt         DateTime    @default(now())

  loadingEvents LoadingEvent[]

  @@map("trucks")
}

model LoadingEvent {
  id             String             @id @default(cuid())
  truck          Truck              @relation(fields: [truckId], references: [id])
  truckId        String
  loadedDate     DateTime
  fromLocation   Location           @relation("LoadingEventFrom", fields: [fromLocationId], references: [id])
  fromLocationId String
  toLocation     Location?          @relation("LoadingEventTo", fields: [toLocationId], references: [id])
  toLocationId   String?
  status         LoadingEventStatus @default(loading)
  createdBy      User               @relation("LoadingEventCreatedBy", fields: [createdById], references: [id])
  createdById    String
  createdAt      DateTime           @default(now())

  lineItems          LoadingLineItem[]
  costs              LoadingCost[]
  transitCheckpoints TransitCheckpoint[]

  @@index([truckId])
  @@map("loading_events")
}

// Append-only ledger: never update/delete, only insert new rows (incl. corrections)
model LoadingLineItem {
  id                 String       @id @default(cuid())
  loadingEvent       LoadingEvent @relation(fields: [loadingEventId], references: [id])
  loadingEventId     String
  intakeBatch        IntakeBatch  @relation(fields: [intakeBatchId], references: [id])
  intakeBatchId      String
  packageCountLoaded Int
  note               String?
  createdBy          User         @relation("LoadingLineCreatedBy", fields: [createdById], references: [id])
  createdById        String
  createdAt          DateTime     @default(now())

  @@index([loadingEventId])
  @@index([intakeBatchId])
  @@map("loading_line_items")
}

model LoadingCost {
  id             String       @id @default(cuid())
  loadingEvent   LoadingEvent @relation(fields: [loadingEventId], references: [id])
  loadingEventId String
  costType       CostType
  amountCny      Decimal      @db.Decimal(12, 2)
  notes          String?
  createdBy      User         @relation("LoadingCostCreatedBy", fields: [createdById], references: [id])
  createdById    String
  createdAt      DateTime     @default(now())

  @@index([loadingEventId])
  @@map("loading_costs")
}

model TransitCheckpoint {
  id             String       @id @default(cuid())
  loadingEvent   LoadingEvent @relation(fields: [loadingEventId], references: [id])
  loadingEventId String
  location       Location     @relation(fields: [locationId], references: [id])
  locationId     String
  arrivedAt      DateTime
  note           String?

  @@index([loadingEventId])
  @@map("transit_checkpoints")
}

model DeliveryReconciliation {
  id                    String               @id @default(cuid())
  client                Client               @relation(fields: [clientId], references: [id])
  clientId              String
  reconDate             DateTime
  expectedPackageCount  Int
  confirmedPackageCount Int?
  discrepancyNotes      String?
  status                ReconciliationStatus @default(pending)
  createdAt             DateTime             @default(now())

  @@index([clientId])
  @@map("delivery_reconciliations")
}

model AuditLog {
  id        String   @id @default(cuid())
  tableName String
  recordId  String
  action    String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  diffJson  Json?
  createdAt DateTime @default(now())

  @@index([tableName, recordId])
  @@map("audit_logs")
}
